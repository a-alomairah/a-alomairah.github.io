---
import '../styles/global.css';
import Marquee from '../components/Marquee.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Abdulrahman Alomairah — software engineer and cybersecurity enthusiast based in Riyadh, Saudi Arabia.',
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://a-alomairah.github.io');
const year = new Date().getFullYear();

const nav = [
  { href: '/about', label: 'About', index: '01' },
  { href: '/portfolio', label: 'Work', index: '02' },
  { href: '/blog', label: 'Writing', index: '03' },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const tickerItems = [
  'Software Engineer',
  'Cybersecurity',
  'Riyadh, Saudi Arabia',
  'Self-Hosting',
  'CTF & Pentesting',
  'KFUPM ’24',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0000f2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Abdulrahman Alomairah" />
    <meta name="twitter:card" content="summary" />

    <title>{title}</title>
  </head>
  <body>
    <Marquee items={tickerItems} />

    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">
          Abdulrahman Alomairah<span class="brand__dot">.</span>
        </a>

        <nav class="nav__links" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class="nav__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="nav__index">{item.index}</span>{item.label}
            </a>
          ))}
          <a
            href="/alomairah_resume.pdf"
            class="btn"
            target="_blank"
            rel="noopener"
          >
            CV ↗
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <h3>Abdulrahman Alomairah</h3>
            <p>
              Software engineer and cybersecurity enthusiast. Building secure
              systems, self-hosted infrastructure, and things worth writing
              about.
            </p>
            <p class="mono" style="margin-top: 1rem; color: rgba(242,242,242,.5);">
              Riyadh, Saudi Arabia
            </p>
          </div>

          <div>
            <h3>Navigate</h3>
            <div class="footer-links">
              <a href="/">Home</a>
              <a href="/about">About</a>
              <a href="/portfolio">Work</a>
              <a href="/blog">Writing</a>
            </div>
          </div>

          <div>
            <h3>Elsewhere</h3>
            <div class="footer-links">
              <a href="https://github.com/a-alomairah" target="_blank" rel="noopener">
                GitHub ↗
              </a>
              <a href="mailto:a.alomairah9@gmail.com">Email ↗</a>
              <a href="/alomairah_resume.pdf" target="_blank" rel="noopener">
                Resume ↗
              </a>
            </div>
          </div>
        </div>

        <span class="footer-word" aria-hidden="true">Alomairah</span>

        <div class="footer-bottom">
          <span>© {year} Abdulrahman Alomairah</span>
          <span>Built with Astro — deployed on GitHub Pages</span>
        </div>
      </div>
    </footer>
  </body>
</html>
