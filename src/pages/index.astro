---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Abdulrahman Alomairah">
  <header class="hero">
    <p class="prompt">a@alomairah ~/$ <span class="cursor">_</span></p>
  </header>

  <Terminal title="whoami">
    <p class="text-green">Abdulrahman Alomairah</p>
    <p class="text-grey">(عبدالرحمن العَميرة)</p>
    <p class="mt-1">Software Engineer & Cybersecurity Enthusiast</p>
    <p>Senior year Software Engineering student @ KFUPM</p>
    <p>Based in Riyadh, Saudi Arabia</p>
    <p class="mt-1">
      <span class="text-dim">email:</span> <a href="mailto:a.alomairah9@gmail.com">a.alomairah9@gmail.com</a>
    </p>
    <p>
      <span class="text-dim">github:</span> <a href="https://github.com/a-alomairah" target="_blank">a-alomairah</a>
    </p>
  </Terminal>

  <Terminal title="cat interests.txt">
    <p>- Penetration Testing & CTFs</p>
    <p>- Self-Hosting & Home Labs</p>
    <p>- Linux (NixOS enthusiast)</p>
    <p>- Software Engineering & Web Development</p>
    <p>- AI / LLM Integration</p>
  </Terminal>

  <section class="mt-3">
    <h2>~/recent-posts $<span class="text-dim"> ls -lt | head -5</span></h2>
    <div class="post-list mt-2">
      {posts.map((post) => {
        const d = post.data.date;
        const dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
        return (
          <a href={`/blog/${post.id}/`} class="post-row">
            <span class="text-dim">{dateStr}</span>
            <span class="text-green">{post.data.title}</span>
          </a>
        );
      })}
    </div>
    <p class="mt-2"><a href="/blog">cd ./blog &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 1.5rem;
  }

  .prompt {
    font-size: 1.5rem;
    color: var(--green);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-row {
    display: flex;
    gap: 1.5rem;
    padding: 0.3rem 0;
    text-decoration: none;
    border-bottom: 1px solid #111;
  }

  .post-row:hover {
    background: #0d0d0d;
  }

  .post-row span:last-child {
    color: var(--green);
  }

  .post-row:hover span:last-child {
    color: var(--purple);
    text-shadow: 0 0 8px var(--purple);
  }
</style>
