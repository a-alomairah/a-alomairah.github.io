---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const projects = [
  {
    id: 'eventscape',
    index: '01',
    title: 'EventScape',
    description:
      'منصة شاملة لإدارة الفعاليات، بميزات مدعومة بالذكاء الاصطناعي، وإشعارات رسائل نصية عبر Twilio، وتطبيق جوال بـ Flutter.',
    scope:
      'بُنيت كمشروع التخرج في هندسة البرمجيات بجامعة الملك فهد، وغطّت الواجهة الخلفية وتطبيق الجوال والنشر.',
    tech: ['Django', 'Flutter', 'Docker', 'LangChain', 'OpenAI', 'Twilio'],
    context: 'مشروع التخرج — جامعة الملك فهد، 2024',
    link: null,
    linkLabel: null,
  },
  {
    id: 'homelab',
    index: '02',
    title: 'الاستضافة الذاتية',
    description:
      'بيئة أستضيفها بنفسي للخدمات التي أعتمد عليها، تعمل على Docker عبر عدد من الأجهزة الافتراضية. نسخ احتياطي، ومراقبة، والتعافي من الأعطال الذي يفرضه تشغيل بنيتك التحتية بنفسك.',
    scope:
      'مشروع شخصي ممتد في تشغيل الخدمات، والشبكات، وإبقاء الأنظمة تعمل دون فاتورة سحابية.',
    tech: ['Docker', 'Linux', 'استضافة ذاتية'],
    context: 'بنية تحتية شخصية',
    link: null,
    linkLabel: null,
  },
  {
    id: 'website',
    index: '03',
    title: 'هذا الموقع',
    description:
      'الموقع الذي تقرأه الآن: بناء Astro و MDX بنظام تصميم مخصص، يُنشر تلقائيًا على GitHub Pages عبر GitHub Actions.',
    scope:
      'التصميم، والتنفيذ، وخط المحتوى، والنشر — دون أي إطار عمل على المتصفح، ودون تتبّع.',
    tech: ['Astro', 'MDX', 'TypeScript', 'GitHub Actions'],
    context: 'موقع شخصي — 2026',
    link: 'https://github.com/a-alomairah/a-alomairah.github.io',
    linkLabel: 'عرض المصدر ↗',
  },
];
---

<BaseLayout
  title="الأعمال — عبدالرحمن العَميرة"
  description="أعمال مختارة لعبدالرحمن العَميرة: منصة فعاليات، بنية تحتية أستضيفها بنفسي، وهذا الموقع."
  lang="ar"
  altPath="/portfolio/"
>
  <section class="page-hero">
    <div class="container">
      <p class="kicker">02 — أعمال مختارة</p>
      <h1 class="page-hero__title display">الأعمال</h1>
      <div class="page-hero__lede">
        <p>
          بعض ما بنيتُه، أو شغّلتُه، أو كسرتُه. وما تبقّى موجود على GitHub.
        </p>
        <p class="mono muted">01—03</p>
      </div>
    </div>
  </section>

  <div class="container">
    {projects.map((project) => (
      <article class="project" id={project.id}>
        <div class="project__top">
          <span class="project__index">{project.index}</span>
          <div>
            <h2 class="project__title">{project.title}</h2>

            <div class="project__body">
              <div>
                <p class="project__desc">{project.description}</p>
                <p class="project__desc" style="margin-top: 1rem;">
                  {project.scope}
                </p>
                {project.link && (
                  <p style="margin-top: 1.25rem;">
                    <a
                      href={project.link}
                      class="link mono"
                      target={project.link.startsWith('http') ? '_blank' : undefined}
                      rel={project.link.startsWith('http') ? 'noopener' : undefined}
                    >
                      {project.linkLabel}
                    </a>
                  </p>
                )}
              </div>

              <div>
                <div class="project__meta">
                  <h3 class="kicker">التقنيات</h3>
                  <ul class="tags">
                    {project.tech.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </div>
                <div class="project__meta">
                  <h3 class="kicker">السياق</h3>
                  <p class="project__desc">{project.context}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2 class="cta__title">المزيد على GitHub.</h2>
        <p class="cta__body">
          تجارب، وأعمال دراسية، ومشاريع ما زالت غير مكتملة بالقدر الذي يجعلها
          دراسة حالة.
        </p>
        <div class="cta__actions">
          <a
            href="https://github.com/a-alomairah"
            class="btn btn--light"
            target="_blank"
            rel="noopener"
          >
            github.com/a-alomairah ↗
          </a>
          <a href="mailto:a.alomairah9@gmail.com" class="btn btn--ghost-light">
            راسلني
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project__desc {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 62ch;
  }
</style>
