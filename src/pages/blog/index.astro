---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout title="Writing — Abdulrahman Alomairah">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">03 — Writing</p>
      <h1 class="page-hero__title display">Writing</h1>
      <div class="page-hero__lede">
        <p>
          Notes on security, Linux, self-hosting, and the things I broke while
          learning.
        </p>
        <p class="mono muted">{String(posts.length).padStart(2, '0')} posts</p>
      </div>
    </div>
  </section>

  <div class="container">
    {posts.map((post, i) => (
      <a href={`/blog/${post.id}/`} class="post-row">
        <span class="post-row__index">{String(i + 1).padStart(2, '0')}</span>
        <span class="post-row__date">{formatDate(post.data.date)}</span>
        <div>
          <h2 class="post-row__title">{post.data.title}</h2>
          {post.data.description && (
            <p class="post-row__desc">{post.data.description}</p>
          )}
          {post.data.categories && (
            <p class="post-row__cats">{post.data.categories.join(' / ')}</p>
          )}
        </div>
        <span class="post-row__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</BaseLayout>
