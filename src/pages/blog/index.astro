---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="./blog — Abdulrahman Alomairah">
  <h1>~/blog $<span class="text-dim"> ls -la</span></h1>

  <div class="ls-table mt-2">
    <div class="ls-header">
      <span>drwxr-xr-x</span>
      <span>date</span>
      <span>filename</span>
    </div>
    {posts.map((post) => {
      const d = post.data.date;
      const month = d.toLocaleDateString('en-US', { month: 'short' });
      const day = String(d.getDate()).padStart(2, ' ');
      const year = d.getFullYear();
      const cats = post.data.categories?.join(', ') || '';
      return (
        <a href={`/blog/${post.id}/`} class="ls-row">
          <span class="text-dim">-rw-r--r--</span>
          <span class="text-dim">{month} {day} {year}</span>
          <span class="text-green filename">{post.data.title}</span>
          {cats && <span class="text-purple cats">[{cats}]</span>}
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  .ls-table {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .ls-header {
    display: flex;
    gap: 1.5rem;
    padding: 0.3rem 0;
    color: var(--dim);
    border-bottom: 1px solid #222;
    font-size: 0.8rem;
  }

  .ls-row {
    display: flex;
    gap: 1.5rem;
    padding: 0.4rem 0;
    text-decoration: none;
    border-bottom: 1px solid #0d0d0d;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .ls-row:hover {
    background: #0d0d0d;
  }

  .ls-row:hover .filename {
    color: var(--purple);
    text-shadow: 0 0 8px var(--purple);
  }

  .cats {
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .ls-header span:first-child,
    .ls-row span:first-child {
      display: none;
    }
  }
</style>
